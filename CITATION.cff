cff-version: 1.2.0
message: "If you use this code, please cite the article."
title: "Tangible vs deep retinal image features"
abstract: >-
  Figure and analysis code for a comparison of measured and deep-learning-derived
  retinal image features. This release reproduces every main figure from the
  accompanying data record; the upstream analysis pipeline follows in a later
  version under the same DOI.
type: software
repository-code: "https://github.com/BergmannLab/tangible-vs-deep-retinal-features"
license: GPL-3.0-only
version: 1.0.0
keywords:
  - GWAS
  - retina
  - retinal fundus imaging
  - UK Biobank
  - image-derived phenotypes
  - deep learning
  - foundation models
# The code's authors, who are also the creators of its Zenodo record; the article's
# authors are under preferred-citation.
authors:
  - family-names: "Beyeler"
    alias: "mjbeyeler"
    given-names: "MJ"
    affiliation: "University of Lausanne, Switzerland"
    orcid: "https://orcid.org/0000-0001-6199-4879"
  - family-names: "Presby"
    alias: "presbyd"
    given-names: "David M."
    affiliation: "University of Lausanne, Switzerland"
    orcid: "https://orcid.org/0000-0002-1788-9980"

